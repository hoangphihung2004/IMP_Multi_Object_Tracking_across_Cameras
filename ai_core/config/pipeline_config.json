{
  "muxer": {
    "width": 1920,
    "height": 1080,
    "batch_size": 2,
    "batched_push_timeout": 40000
  },
  "decode": {
    "parser": "h264parse",
    "decoder": "nvv4l2decoder"
  },
  "infer": {
    "config_file": "config/config_infer.txt"
  },
  "osd": {
    "enabled": true,
    "bbox_border_width": 3,
    "font_name": "Serif",
    "font_size": 12
  },
  "output": {
    "codec": "h264",
    "encoder": "nvv4l2h264enc",
    "bitrate": 4000000,
    "container": "mp4",
    "muxer": "qtmux",
    "parser": "h264parse"
  },
  "stop_policy": "all_eos"
}
