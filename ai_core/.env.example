# ==============================================================================
# AI Core Jetson - Environment Variables
# Copy this file to config/.env and fill in the values for your deployment.
# ==============================================================================

# ---------------------------------------------------------
# Pipeline / Camera Configuration
# ---------------------------------------------------------
# USB Camera device or video file path
VIDEO_SOURCE=/dev/video0

# Path to the nvinfer config file (relative to working dir)
CONFIG_INFER=config/config_infer.txt

# ---------------------------------------------------------
# Model Conversion (PTH → ONNX → TensorRT)
# ---------------------------------------------------------
# Auto-converts: if .engine missing → build from .onnx → build from .pth
# Leave blank to use yolox_config.json values as source of truth.
MODEL_ENGINE_PATH=pretrained/model_trt.engine
MODEL_ONNX_PATH=pretrained/model_trt.onnx
MODEL_PTH_PATH=pretrained/ocsort_x_mot20.pth.tar
TRT_FP16=1
TRT_WORKSPACE_MB=7168

# ---------------------------------------------------------
# WebSocket — Backend Integration (Azure)
# ---------------------------------------------------------
# Push per-frame results (tracks, counts, map positions)
RESULTS_WS_URL=
# Hot-reload: receive live config updates from Django backend
MAPPING_SETTINGS_WS_URL=
COUNTING_SETTINGS_WS_URL=
# Bearer token for WebSocket auth
API_BEARER_TOKEN=

# ---------------------------------------------------------
# WebRTC / Janus Streaming (Jetson → Azure)
# ---------------------------------------------------------
JANUS_SERVER_IP=20.189.72.185
JANUS_UDP_PORT=8004

# GStreamer encoding
VIDEO_BITRATE=1200000

# ---------------------------------------------------------
# Alert Thresholds
# ---------------------------------------------------------
ALERT_WARNING_THRESH=25
ALERT_CRITICAL_THRESH=50
